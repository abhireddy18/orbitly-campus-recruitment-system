<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:background="?attr/colorSurface">

    <TextView
        style="@style/SectionLabel"
        android:layout_width="wrap_content"
        android:text="DISCOVER OPPORTUNITIES" />

    <TextView
        style="@style/ScreenTitle"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="Find your next role" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_saved_jobs"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="View saved jobs"
        android:textColor="@color/brand_teal_dark"
        app:cornerRadius="10dp"
        app:strokeColor="@color/line_subtle" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeColor="?attr/colorPrimary"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxBackgroundMode="outline"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title, company or skill"
            android:textSize="16sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <ListView
        android:id="@+id/lv_jobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/tv_no_jobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No matching opportunities"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply_job"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="Continue to applications"
        android:textSize="15sp"
        app:backgroundTint="@color/brand_teal"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_go_back"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="Go Back"
        style="@style/GoBack"
        app:cornerRadius="12dp" />
</LinearLayout>
