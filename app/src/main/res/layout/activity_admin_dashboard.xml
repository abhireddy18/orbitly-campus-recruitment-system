<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="34dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/SectionLabel"
            android:layout_width="wrap_content"
            android:text="ADMINISTRATION" />

        <TextView
            style="@style/ScreenTitle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:text="Welcome, Admin" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="Manage the campus recruitment workspace."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_marginBottom="8dp"
            android:text="DIRECTORY" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_students"
            style="@style/DashboardButtonStyle"
            android:text="Manage Students"
            app:backgroundTint="@color/brand_teal"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_companies"
            style="@style/DashboardSecondaryButtonStyle"
            android:text="Manage Companies"
            app:cornerRadius="12dp" />

        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="RECRUITMENT" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_applications"
            style="@style/DashboardSecondaryButtonStyle"
            android:text="Manage Applications"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_jobs"
            style="@style/DashboardSecondaryButtonStyle"
            android:text="Manage Jobs"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_interviews"
            style="@style/DashboardSecondaryButtonStyle"
            android:text="Manage Interviews"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_feedbacks"
            style="@style/DashboardSecondaryButtonStyle"
            android:text="Manage Feedbacks"
            android:textColor="@color/brand_coral"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/DashboardSecondaryButtonStyle"
            android:layout_marginTop="24dp"
            android:text="Logout"
            android:textColor="@color/brand_coral"
            app:cornerRadius="12dp" />
    </LinearLayout>
</ScrollView>
