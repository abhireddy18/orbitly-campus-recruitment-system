<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        style="@style/SectionLabel"
        android:layout_width="wrap_content"
        android:text="YOUR SHORTLIST" />

    <TextView
        style="@style/ScreenTitle"
        android:layout_marginTop="8dp"
        android:text="Saved jobs" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="Keep promising roles close while you decide."
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/lv_saved_jobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/tv_empty_saved_jobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No saved jobs yet"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_browse_jobs"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="Browse jobs"
        android:textSize="15sp"
        app:backgroundTint="@color/brand_teal"
        app:cornerRadius="12dp" />
</LinearLayout>
